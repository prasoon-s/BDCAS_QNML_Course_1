    function renderAcademicMarkdown(mdText) {
      if (!mdText) return '';
      let html = mdText
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      html = html.replace(/\$\$([\s\S]*?)\$\$/g, (_, math) => {
        return `<div class="math-block my-2.5 font-mono text-xs sm:text-sm text-naamii-navy dark:text-sky-300 font-semibold">${math.trim()}</div>`;
      });

      html = html.replace(/\$([^\$\n]+?)\$/g, (_, math) => {
        return `<code class="font-mono text-xs px-1 py-0.5 rounded bg-sky-500/10 text-naamii-navy dark:text-sky-300 font-semibold">${math}</code>`;
      });

      html = html.replace(/`([^`\n]+?)`/g, (_, code) => {
        return `<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-naamii-blue dark:text-sky-300">${code}</code>`;
      });

      html = html.replace(/\*\*([^\*\n]+?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/\*([^\*\n]+?)\*/g, '<em>$1</em>');

      const lines = html.split('\n');
      const out = [];
      let inList = false;
      for (let line of lines) {
        if (line.startsWith('### ')) {
          if (inList) { out.push('</ul>'); inList = false; }
          out.push(`<h3 class="text-base font-bold text-naamii-navy dark:text-sky-300 mt-4 mb-1.5 border-b border-slate-200/70 dark:border-slate-800 pb-1">${line.slice(4)}</h3>`);
        } else if (line.startsWith('## ')) {
          if (inList) { out.push('</ul>'); inList = false; }
          out.push(`<h2 class="text-lg font-bold text-naamii-navy dark:text-white mt-4 mb-2">${line.slice(3)}</h2>`);
        } else if (line.startsWith('# ')) {
          if (inList) { out.push('</ul>'); inList = false; }
          out.push(`<h1 class="text-xl font-extrabold text-naamii-navy dark:text-white mb-2">${line.slice(2)}</h1>`);
        } else if (line.trim().startsWith('* ')) {
          if (!inList) { out.push('<ul class="list-disc pl-5 space-y-1.5 my-2">'); inList = true; }
          out.push(`<li>${line.trim().slice(2)}</li>`);
        } else if (line.trim() === '') {
          if (inList) { out.push('</ul>'); inList = false; }
        } else {
          if (inList) { out.push('</ul>'); inList = false; }
          out.push(`<p class="my-1.5">${line}</p>`);
        }
      }
      if (inList) out.push('</ul>');
      return out.join('\n');
    }

    function computeLiveDeviceFingerprint() {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 180;
        canvas.height = 36;
        const ctx = canvas.getContext('2d');
        ctx.textBaseline = 'top';
        ctx.font = '13px Helvetica';
        ctx.fillStyle = '#002060';
        ctx.fillRect(10, 4, 80, 20);
        ctx.fillStyle = '#2980B9';
        ctx.fillText('NAAMII_BDCAS_DRM', 14, 8);
        const dataUrl = canvas.toDataURL();
        let hash = 2166136261;
        for (let i = 0; i < dataUrl.length; i++) {
          hash ^= dataUrl.charCodeAt(i);
          hash = Math.imul(hash, 16777619);
        }
        const canvasHex = 'c2d_' + (hash >>> 0).toString(16).padStart(8, '0') + '72c1';
        const cores = navigator.hardwareConcurrency || 8;
        const plat = navigator.platform || 'Linux x86_64';
        const compHex = 'fp_' + (hash >>> 0).toString(16).padStart(8, '0') + '9b047d11';

        document.getElementById('fpCanvasVal').textContent = canvasHex;
        document.getElementById('fpOsVal').textContent = `${plat} • ${cores} Threads`;
        document.getElementById('fpCompositeVal').textContent = compHex;
        document.getElementById('headerDeviceHash').textContent = compHex.slice(0, 13) + '...';
        state.adminAccount.deviceHash = compHex;
      } catch (e) {
      }
    }

