    function showToast(title, message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const colors = {
        info: 'bg-naamii-navy border-naamii-blue text-white',
        success: 'bg-emerald-900 border-emerald-400 text-emerald-50',
        warn: 'bg-amber-900 border-amber-400 text-amber-50',
        danger: 'bg-rose-950 border-rose-500 text-rose-100'
      };
      const el = document.createElement('div');
      el.className = `pointer-events-auto p-3.5 rounded-xl border shadow-lg transition-all duration-300 ${colors[type] || colors.info}`;
      el.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div>
            <div class="text-xs font-bold">${title}</div>
            <div class="text-[11px] opacity-90 mt-0.5 leading-snug">${message}</div>
          </div>
          <button type="button" class="btn-close-toast text-xs opacity-75 hover:opacity-100 font-bold">✕</button>
        </div>
      `;
      el.querySelector('.btn-close-toast').addEventListener('click', () => el.remove());
      container.appendChild(el);
      setTimeout(() => {
        if (el.parentNode) el.remove();
      }, 4800);
    }

